# ignore everything Maven writes to target/, except the runnable Spring Boot JAR
# that the Dockerfile copies (target/openinghours-*.jar). Deny-all + re-include
# keeps new build artifacts (jacoco, failsafe, site, ...) out of the context
# automatically, instead of needing a new line here each time.
target/*
!target/*.jar
build/

# ignore ide modeules
.idea/
*.iml
*.ipr
*.iws
*.sw?

# ignore Git
.git/
.gitignore

# ignore system files
.DS_Store
Thumbs.db

# ignore environment files
.env
*.log

# ignore tests
*.test.js
*.spec.js
__tests__/

# optional: ignore other files
*.tmp
*.bak
*.old
